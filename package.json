{
  "name": "onetime-link",
  "version": "1.0.0",
  "description": "One-Time Link Converter - Secure single-use redirect links",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run build:css",
    "build:css": "tailwindcss -i src/public/css/input.css -o src/public/css/output.css --minify",
    "dev": "concurrently \"tsc --watch\" \"tailwindcss -i src/public/css/input.css -o src/public/css/output.css --watch\" \"nodemon dist/index.js\"",
    "start": "node dist/index.js",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate"
  },
  "keywords": ["one-time-link", "url-shortener", "single-use", "redirect", "saas"],
  "author": "Harry Roger",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "bcrypt": "^5.1.1",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.6",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "nanoid": "^3.3.8",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "ua-parser-js": "^2.0.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.15.0",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.7.0",
    "supertest": "^7.1.0",
    "@types/supertest": "^6.0.3",
    "tailwindcss": "^3.4.17",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
