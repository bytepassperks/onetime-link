# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/onetime_link?schema=public

# Application
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=your-session-secret-at-least-32-chars-long-here

# Admin Seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-secure-password
ADMIN_NAME=Admin

# Link Defaults
DEFAULT_LINK_EXPIRY_HOURS=24

# Rate Limiting
LINK_CREATION_RATE_LIMIT_WINDOW_MIN=15
LINK_CREATION_RATE_LIMIT_MAX=10
ADMIN_LOGIN_RATE_LIMIT_WINDOW_MIN=15
ADMIN_LOGIN_RATE_LIMIT_MAX=5

# Features
ALLOW_PUBLIC_LINK_CREATION=true
REQUIRE_INTERSTITIAL_FOR_SUSPECT_UA=true
