<% layout('layouts/main') %>

<div class="max-w-lg mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="card text-center">
    <div class="w-16 h-16 mx-auto bg-yellow-900/50 rounded-full flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-yellow-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
    </div>

    <h1 class="text-xl font-bold text-white mb-2">Password Required</h1>
    <p class="text-gray-400 text-sm mb-6">This link is password-protected. Enter the password to continue.</p>

    <% if (error) { %>
      <div class="mb-4 p-3 bg-red-900/50 border border-red-800 rounded-lg text-red-300 text-sm"><%= error %></div>
    <% } %>

    <form method="POST" action="/r/<%= slug %>" class="space-y-4" data-disable-on-submit="Unlocking...">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="password" name="password" class="input-field text-center" placeholder="Enter password" required autofocus>
      <button type="submit" class="btn-primary w-full">Unlock & Continue</button>
    </form>
  </div>
</div>
