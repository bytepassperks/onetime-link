<% layout('layouts/main') %>

<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <section class="py-20 lg:py-32 text-center">
    <div class="max-w-3xl mx-auto">
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight">
        Secure <span class="text-brand-400">Single-Use</span> Links
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-gray-400 leading-relaxed">
        <%= brandTagline %>. Create a link that works exactly once. After the first click, it's gone forever. 
        No more worrying about shared links being accessed by unintended recipients.
      </p>
      <% if (allowPublicCreation) { %>
        <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a href="/create" class="btn-primary text-lg px-8 py-3">Create a Link</a>
        </div>
      <% } %>
    </div>
  </section>

  <section class="py-16 border-t border-gray-800">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="card text-center">
        <div class="w-12 h-12 mx-auto bg-brand-900/50 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Single-Use Security</h3>
        <p class="text-gray-400 text-sm">Each link can only be accessed once. After the first visit, it self-destructs and can never be used again.</p>
      </div>
      <div class="card text-center">
        <div class="w-12 h-12 mx-auto bg-green-900/50 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Bot Protection</h3>
        <p class="text-gray-400 text-sm">Advanced detection prevents bots, crawlers, and chat preview agents from accidentally consuming your links.</p>
      </div>
      <div class="card text-center">
        <div class="w-12 h-12 mx-auto bg-purple-900/50 rounded-xl flex items-center justify-center mb-4">
          <svg class="w-6 h-6 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </div>
        <h3 class="text-lg font-semibold text-white mb-2">Optional Expiry</h3>
        <p class="text-gray-400 text-sm">Set an expiration time for your links. Even if unused, they'll automatically expire when the time is up.</p>
      </div>
    </div>
  </section>

  <section class="py-16 border-t border-gray-800">
    <h2 class="text-2xl font-bold text-white text-center mb-12">How It Works</h2>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
      <div class="text-center">
        <div class="w-10 h-10 mx-auto bg-brand-600 rounded-full flex items-center justify-center text-white font-bold mb-3">1</div>
        <h4 class="font-medium text-white mb-1">Paste your URL</h4>
        <p class="text-sm text-gray-500">Enter the destination URL you want to share securely.</p>
      </div>
      <div class="text-center">
        <div class="w-10 h-10 mx-auto bg-brand-600 rounded-full flex items-center justify-center text-white font-bold mb-3">2</div>
        <h4 class="font-medium text-white mb-1">Get a short link</h4>
        <p class="text-sm text-gray-500">Receive a unique, single-use link to share with your recipient.</p>
      </div>
      <div class="text-center">
        <div class="w-10 h-10 mx-auto bg-brand-600 rounded-full flex items-center justify-center text-white font-bold mb-3">3</div>
        <h4 class="font-medium text-white mb-1">Share it</h4>
        <p class="text-sm text-gray-500">Send the link via any channel — email, chat, SMS.</p>
      </div>
      <div class="text-center">
        <div class="w-10 h-10 mx-auto bg-brand-600 rounded-full flex items-center justify-center text-white font-bold mb-3">4</div>
        <h4 class="font-medium text-white mb-1">One click, done</h4>
        <p class="text-sm text-gray-500">After the first human click, the link is permanently consumed.</p>
      </div>
    </div>
  </section>
</div>
