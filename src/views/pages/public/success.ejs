<% layout('layouts/main') %>

<div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <div class="card text-center">
    <div class="w-16 h-16 mx-auto bg-green-900/50 rounded-full flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
    </div>

    <% if (batchShortUrls && batchShortUrls.length) { %>
      <h1 class="text-2xl font-bold text-white mb-2">Links Created Successfully</h1>
      <p class="text-gray-400 mb-6">Your batch is ready to share.</p>

      <div class="space-y-3 mb-6 text-left">
        <% batchShortUrls.forEach(function(item, index) { %>
          <div class="bg-gray-800 rounded-lg p-4 flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-gray-700 flex items-center justify-center text-xs text-gray-300"><%= index + 1 %></div>
            <input type="text" readonly value="<%= item.shortUrl %>" class="flex-1 bg-gray-700 border border-gray-600 rounded-lg px-3 py-2 text-white text-sm font-mono">
            <button data-copy="<%= item.shortUrl %>" class="copy-btn btn-primary px-4 py-2 text-sm">Copy</button>
          </div>
        <% }) %>
      </div>

      <p class="text-sm text-gray-500 mb-6"><%= batchCount %> one-time links were created. Each URL can be used once.</p>
    <% } else { %>
      <h1 class="text-2xl font-bold text-white mb-2">Link Created Successfully</h1>
      <p class="text-gray-400 mb-6">Your one-time link is ready to share.</p>

      <div class="bg-gray-800 rounded-lg p-4 mb-6">
        <p class="text-xs text-gray-500 mb-2 uppercase tracking-wide">Your LinkOnce URL</p>
        <div class="flex items-center gap-2">
          <input type="text" readonly value="<%= shortUrl %>" class="flex-1 bg-gray-700 border border-gray-600 rounded-lg px-4 py-2.5 text-white text-sm font-mono" id="linkUrl">
          <button data-copy="<%= shortUrl %>" class="copy-btn btn-primary px-4 py-2.5 text-sm">Copy</button>
        </div>
      </div>

      <div class="bg-yellow-900/30 border border-yellow-800/50 rounded-lg p-4 mb-6">
        <div class="flex items-start space-x-3">
          <svg class="w-5 h-5 text-yellow-400 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
          <div class="text-left">
            <p class="text-yellow-300 text-sm font-medium">This link is single-use</p>
            <p class="text-yellow-400/80 text-xs mt-1">
              This link can be used <strong><%= maxViews %></strong> time<%= maxViews > 1 ? 's' : '' %>. After that, it will be permanently deactivated.
              <% if (hasPassword) { %><br>This link is password-protected.<% } %>
              <% if (expiresAt) { %><br>Expires: <%= new Date(expiresAt).toLocaleString() %><% } %>
            </p>
          </div>
        </div>
      </div>
    <% } %>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/create" class="btn-secondary">Create Another Link</a>
      <a href="/" class="text-sm text-gray-500 hover:text-gray-300 py-2.5 transition-colors">Back to Home</a>
    </div>
  </div>
</div>
