<% layout('layouts/main') %>

<div class="max-w-lg mx-auto px-4 sm:px-6 lg:px-8 py-20">
  <div class="card text-center">
    <div class="w-16 h-16 mx-auto bg-red-900/50 rounded-full flex items-center justify-center mb-4">
      <svg class="w-8 h-8 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
    </div>
    <h1 class="text-xl font-bold text-white mb-2"><%= title %></h1>
    <p class="text-gray-400 text-sm"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred.' %></p>
    <a href="/" class="inline-block mt-6 text-sm text-brand-400 hover:text-brand-300 transition-colors">Back to Home</a>
  </div>
</div>
