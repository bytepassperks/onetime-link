<% layout('layouts/admin') %>

<div class="max-w-2xl">
  <h1 class="text-2xl font-bold text-white mb-6">Create Link (Admin)</h1>

  <% if (error) { %>
    <div class="mb-6 p-4 bg-red-900/50 border border-red-800 rounded-lg text-red-300 text-sm"><%= error %></div>
  <% } %>

  <div class="card">
    <form method="POST" action="/admin/links/create" class="space-y-5" id="adminCreateLinkForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="destinationUrl" class="block text-sm font-medium text-gray-300 mb-1">Destination URL <span class="text-red-400">*</span></label>
        <input type="url" id="destinationUrl" name="destinationUrl" class="input-field" placeholder="https://example.com" required value="<%= formData?.destinationUrl || '' %>">
      </div>

      <div>
        <label for="slug" class="block text-sm font-medium text-gray-300 mb-1">Custom Slug <span class="text-gray-500">(optional)</span></label>
        <input type="text" id="slug" name="slug" class="input-field" placeholder="custom-slug" value="<%= formData?.slug || '' %>">
      </div>

      <div>
        <label for="label" class="block text-sm font-medium text-gray-300 mb-1">Label <span class="text-gray-500">(optional)</span></label>
        <input type="text" id="label" name="label" class="input-field" placeholder="Description for this link" value="<%= formData?.label || '' %>">
      </div>

      <div>
        <label for="mode" class="block text-sm font-medium text-gray-300 mb-1">Redemption mode</label>
        <select id="mode" name="mode" class="input-field">
          <option value="single" <%= !formData?.mode || formData.mode === 'single' ? 'selected' : '' %>>Single-use link</option>
          <option value="batch" <%= formData?.mode === 'batch' ? 'selected' : '' %>>Multiple separate one-time links</option>
          <option value="unique_clients" <%= formData?.mode === 'unique_clients' ? 'selected' : '' %>>One link, N unique clients</option>
        </select>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="password" class="block text-sm font-medium text-gray-300 mb-1">Password <span class="text-gray-500">(optional)</span></label>
          <input type="password" id="password" name="password" class="input-field" value="<%= formData?.password || '' %>">
        </div>
        <div>
          <label for="maxViews" class="block text-sm font-medium text-gray-300 mb-1" id="maxViewsLabel">How many total views?</label>
          <input type="number" id="maxViews" name="maxViews" class="input-field" min="1" max="1000" value="<%= formData?.maxViews || '1' %>">
        </div>
      </div>

      <div id="batchQuantityWrap" class="hidden">
        <label for="quantity" class="block text-sm font-medium text-gray-300 mb-1">How many links?</label>
        <input type="number" id="quantity" name="quantity" class="input-field" min="1" max="1000" value="<%= formData?.quantity || '1' %>">
      </div>

      <div id="maxClientsWrap" class="hidden">
        <label for="maxClients" class="block text-sm font-medium text-gray-300 mb-1">Max unique clients</label>
        <input type="number" id="maxClients" name="maxClients" class="input-field" min="1" max="1000" value="<%= formData?.maxClients || '1' %>">
      </div>

      <div>
        <label for="expiresAt" class="block text-sm font-medium text-gray-300 mb-1">Expires At <span class="text-gray-500">(optional)</span></label>
        <input type="datetime-local" id="expiresAt" name="expiresAt" class="input-field" value="<%= formData?.expiresAt || '' %>">
      </div>

      <div>
        <label for="notes" class="block text-sm font-medium text-gray-300 mb-1">Notes <span class="text-gray-500">(optional)</span></label>
        <textarea id="notes" name="notes" rows="2" class="input-field"><%= formData?.notes || '' %></textarea>
      </div>

      <button type="submit" class="btn-primary w-full">Create Link</button>
    </form>
  </div>
</div>

<script>
  (function() {
    var mode = document.getElementById('mode');
    var maxViewsGroup = document.getElementById('maxViews').parentElement;
    var batchQuantityWrap = document.getElementById('batchQuantityWrap');
    var maxClientsWrap = document.getElementById('maxClientsWrap');
    var maxViewsLabel = document.getElementById('maxViewsLabel');
    function update() {
      var value = mode.value;
      var isBatch = value === 'batch';
      var isUnique = value === 'unique_clients';
      batchQuantityWrap.classList.toggle('hidden', !isBatch);
      maxClientsWrap.classList.toggle('hidden', !isUnique);
      maxViewsGroup.classList.toggle('hidden', isBatch || isUnique);
      maxViewsLabel.textContent = 'How many total views?';
    }
    mode.addEventListener('change', update);
    update();
  })();
</script>
