<% layout('layouts/admin') %>

<div>
  <div class="flex items-center gap-3 mb-6">
    <a href="/admin/links" class="text-gray-500 hover:text-gray-300 transition-colors">
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
    </a>
    <h1 class="text-2xl font-bold text-white">Link: <span class="font-mono text-brand-400"><%= link.slug %></span></h1>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2 card">
      <h2 class="text-lg font-semibold text-white mb-4">Details</h2>
      <dl class="space-y-3">
        <div class="flex justify-between items-start">
          <dt class="text-sm text-gray-500">Short URL</dt>
          <dd class="text-sm text-gray-200 font-mono flex items-center gap-2">
            <%= baseUrl %>/r/<%= link.slug %>
            <button data-copy="<%= baseUrl %>/r/<%= link.slug %>" class="copy-btn text-xs px-2 py-1 bg-gray-700 rounded hover:bg-gray-600">Copy</button>
          </dd>
        </div>
        <div class="flex justify-between items-start">
          <dt class="text-sm text-gray-500">Destination</dt>
          <dd class="text-sm text-gray-200 break-all"><a href="<%= link.destinationUrl %>" target="_blank" class="text-brand-400 hover:text-brand-300"><%= link.destinationUrl %></a></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Status</dt>
          <dd>
            <% if (link.status === 'active') { %><span class="badge-active">Active</span>
            <% } else if (link.status === 'consumed') { %><span class="badge-consumed">Consumed</span>
            <% } else if (link.status === 'expired') { %><span class="badge-expired">Expired</span>
            <% } else if (link.status === 'disabled') { %><span class="badge-disabled">Disabled</span>
            <% } else { %><span class="badge-deleted">Deleted</span>
            <% } %>
          </dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Mode</dt>
          <dd class="text-sm text-gray-200"><%= link.redemptionMode %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Views</dt>
          <dd class="text-sm text-gray-200"><%= link.viewCount %> / <%= link.maxViews %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Password Protected</dt>
          <dd class="text-sm text-gray-200"><%= link.passwordHash ? 'Yes' : 'No' %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Label</dt>
          <dd class="text-sm text-gray-200"><%= link.label || '—' %></dd>
        </div>
        <div class="flex justify-between items-start">
          <dt class="text-sm text-gray-500">Notes</dt>
          <dd class="text-sm text-gray-200 break-all"><%= link.notes || '—' %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Created</dt>
          <dd class="text-sm text-gray-200"><%= new Date(link.createdAt).toLocaleString() %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Expires</dt>
          <dd class="text-sm text-gray-200"><%= link.expiresAt ? new Date(link.expiresAt).toLocaleString() : 'Never' %></dd>
        </div>
        <% if (link.consumedAt) { %>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Consumed At</dt>
          <dd class="text-sm text-gray-200"><%= new Date(link.consumedAt).toLocaleString() %></dd>
        </div>
        <% } %>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Created By</dt>
          <dd class="text-sm text-gray-200"><%= link.createdBy ? (link.createdBy.name || link.createdBy.email) : 'Public User' %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-sm text-gray-500">Source</dt>
          <dd class="text-sm text-gray-200"><%= link.isPublic ? 'Public Form' : 'Admin Panel' %></dd>
        </div>
        <% if (link.batchId) { %>
        <div class="flex justify-between items-start">
          <dt class="text-sm text-gray-500">Batch ID</dt>
          <dd class="text-sm text-gray-200 font-mono break-all"><%= link.batchId %></dd>
        </div>
        <% } %>
      </dl>
    </div>

    <div class="card">
      <h2 class="text-lg font-semibold text-white mb-4">Actions</h2>
      <div class="space-y-3">
        <% if (link.status === 'active' || link.status === 'disabled') { %>
          <form method="POST" action="/admin/links/<%= link.id %>/toggle">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="enable" value="<%= link.status === 'disabled' ? 'true' : 'false' %>">
            <button type="submit" class="<%= link.status === 'disabled' ? 'btn-success' : 'btn-secondary' %> w-full text-sm">
              <%= link.status === 'disabled' ? 'Enable Link' : 'Disable Link' %>
            </button>
          </form>
        <% } %>

        <form method="POST" action="/admin/links/<%= link.id %>/regenerate-slug" data-confirm="This will generate a new slug. The old URL will stop working. Continue?">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-secondary w-full text-sm">Regenerate Slug</button>
        </form>

        <form method="POST" action="/admin/links/<%= link.id %>/extend-expiry" class="space-y-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="datetime-local" name="expiresAt" class="input-field text-sm">
          <button type="submit" class="btn-secondary w-full text-sm">Extend Expiry</button>
        </form>

        <hr class="border-gray-800">

        <form method="POST" action="/admin/links/<%= link.id %>/delete" data-confirm="Are you sure you want to delete this link? This action uses soft-delete.">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="btn-danger w-full text-sm">Delete Link</button>
        </form>
      </div>
    </div>
  </div>

  <% if (link.redemptionMode === 'unique_clients' && link.redemptions && link.redemptions.length) { %>
  <div class="card mb-8">
    <h2 class="text-lg font-semibold text-white mb-4">Redemptions</h2>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Redeemed At</th>
            <th>Client</th>
            <th>IP Hash</th>
            <th>User Agent</th>
          </tr>
        </thead>
        <tbody>
          <% link.redemptions.forEach(function(redemption) { %>
            <tr>
              <td class="text-gray-400 text-xs whitespace-nowrap"><%= new Date(redemption.redeemedAt).toLocaleString() %></td>
              <td class="text-gray-300 text-xs font-mono"><%= redemption.clientId.substring(0, 10) %>...</td>
              <td class="text-gray-400 text-xs font-mono"><%= redemption.ipHash ? redemption.ipHash.substring(0, 10) + '...' : '—' %></td>
              <td class="text-gray-500 text-xs max-w-sm truncate"><%= redemption.userAgent || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <% if (link.batchId && link.batchLinks && link.batchLinks.length > 1) { %>
  <div class="card mb-8">
    <h2 class="text-lg font-semibold text-white mb-4">Batch Links</h2>
    <div class="space-y-2">
      <% link.batchLinks.forEach(function(batchLink) { %>
        <a href="/admin/links/<%= batchLink.id %>" class="block bg-gray-800 rounded-lg px-4 py-3 text-sm text-gray-300 hover:text-white">
          <span class="font-mono text-brand-400"><%= batchLink.slug %></span> — <%= batchLink.status %>
        </a>
      <% }) %>
    </div>
  </div>
  <% } %>

  <div class="card">
    <h2 class="text-lg font-semibold text-white mb-4">Access Events</h2>
    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Time</th>
            <th>Event</th>
            <th>IP Hash</th>
            <th>User Agent</th>
            <th>Referer</th>
          </tr>
        </thead>
        <tbody>
          <% if (link.accessEvents.length === 0) { %>
            <tr><td colspan="5" class="text-center text-gray-500 py-6">No access events yet</td></tr>
          <% } %>
          <% link.accessEvents.forEach(function(event) { %>
            <tr>
              <td class="text-gray-400 text-xs whitespace-nowrap"><%= new Date(event.timestamp).toLocaleString() %></td>
              <td class="text-gray-300 text-xs"><%= event.eventType %></td>
              <td class="text-gray-500 text-xs font-mono"><%= event.ipHash ? event.ipHash.substring(0, 10) + '...' : '—' %></td>
              <td class="text-gray-500 text-xs max-w-sm truncate"><%= event.userAgent || '—' %></td>
              <td class="text-gray-500 text-xs max-w-sm truncate"><%= event.referer || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
