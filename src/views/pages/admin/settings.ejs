<% layout('layouts/admin') %>

<div class="max-w-2xl">
  <h1 class="text-2xl font-bold text-white mb-6">Settings</h1>

  <% if (success) { %>
    <div class="mb-6 p-4 bg-green-900/50 border border-green-800 rounded-lg text-green-300 text-sm"><%= success %></div>
  <% } %>

  <div class="card">
    <form method="POST" action="/admin/settings" class="space-y-6">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <h2 class="text-lg font-semibold text-white mb-4">Branding</h2>
        <div class="space-y-4">
          <div>
            <label for="brand_name" class="block text-sm font-medium text-gray-300 mb-1">Brand Name</label>
            <input type="text" id="brand_name" name="brand_name" class="input-field" value="<%= settings.brand_name || '' %>">
          </div>
          <div>
            <label for="brand_tagline" class="block text-sm font-medium text-gray-300 mb-1">Brand Tagline</label>
            <input type="text" id="brand_tagline" name="brand_tagline" class="input-field" value="<%= settings.brand_tagline || '' %>">
          </div>
          <div>
            <label for="base_domain" class="block text-sm font-medium text-gray-300 mb-1">Base Domain / URL</label>
            <input type="url" id="base_domain" name="base_domain" class="input-field" value="<%= settings.base_domain || '' %>">
          </div>
        </div>
      </div>

      <hr class="border-gray-800">

      <div>
        <h2 class="text-lg font-semibold text-white mb-4">Link Defaults</h2>
        <div>
          <label for="default_expiry_hours" class="block text-sm font-medium text-gray-300 mb-1">Default Expiry (hours)</label>
          <input type="number" id="default_expiry_hours" name="default_expiry_hours" class="input-field" min="1" value="<%= settings.default_expiry_hours || '24' %>">
        </div>
      </div>

      <hr class="border-gray-800">

      <div>
        <h2 class="text-lg font-semibold text-white mb-4">Security & Access</h2>
        <div class="space-y-3">
          <label class="flex items-center gap-3">
            <input type="checkbox" name="anti_bot_enabled" value="true" class="w-4 h-4 rounded bg-gray-800 border-gray-600 text-brand-600 focus:ring-brand-500" <%= settings.anti_bot_enabled === 'true' ? 'checked' : '' %>>
            <span class="text-sm text-gray-300">Enable anti-bot detection</span>
          </label>
          <label class="flex items-center gap-3">
            <input type="checkbox" name="require_interstitial" value="true" class="w-4 h-4 rounded bg-gray-800 border-gray-600 text-brand-600 focus:ring-brand-500" <%= settings.require_interstitial === 'true' ? 'checked' : '' %>>
            <span class="text-sm text-gray-300">Show interstitial page for suspicious user agents</span>
          </label>
          <label class="flex items-center gap-3">
            <input type="checkbox" name="allow_public_creation" value="true" class="w-4 h-4 rounded bg-gray-800 border-gray-600 text-brand-600 focus:ring-brand-500" <%= settings.allow_public_creation === 'true' ? 'checked' : '' %>>
            <span class="text-sm text-gray-300">Allow public link creation (non-admin)</span>
          </label>
          <label class="flex items-center gap-3">
            <input type="checkbox" name="registration_enabled" value="true" class="w-4 h-4 rounded bg-gray-800 border-gray-600 text-brand-600 focus:ring-brand-500" <%= settings.registration_enabled === 'true' ? 'checked' : '' %>>
            <span class="text-sm text-gray-300">Enable user registration</span>
          </label>
        </div>
      </div>

      <button type="submit" class="btn-primary w-full">Save Settings</button>
    </form>
  </div>
</div>
